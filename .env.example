GOOGLE_DRIVE_FOLDER_ID=12Dz6_w7C3OAZmyOHx5kq1L8okOYla_7A
# Drive OAuth user credentials are loaded from token.json; generate with authenticate.py.
GOOGLE_OAUTH_TOKEN_FILE=token.json
TOPIC_MAP_FILE=topic_map.json
